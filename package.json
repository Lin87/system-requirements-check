{
    "name": "system-requirements-check",
    "version": "1.2.5",
    "description": "Checks the specified OS version, browser, screen resolution, IP address, Flash Player, JRE, cookies, and JavaScript.",
    "keywords": [
        "system",
        "requirements",
        "check"
    ],
    "homepage": "https://github.com/Lin87/system-requirements-check#readme",
    "bugs": {
        "url": "https://github.com/Lin87/system-requirements-check/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Lin87/system-requirements-check.git"
    },
    "license": "GPL-3.0-or-later",
    "author": "Ethan Lin",
    "type": "commonjs",
    "main": "build/index.js",
    "scripts": {
        "css": "grunt css",
        "build": "wp-scripts build && grunt",
        "packages-update": "wp-scripts packages-update",
        "plugin-zip": "wp-scripts plugin-zip",
        "start": "wp-scripts start",
        "ship": "npm run build && npm run plugin-zip",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "browserslist": [
        "last 2 versions",
        "> 1%",
        "ie >= 9",
        "Edge >= 15",
        "Firefox ESR",
        "not dead"
    ],
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.13",
        "@wordpress/scripts": "^30.12.0",
        "autoprefixer": "^10.4.21",
        "cssnano": "^7.1.1",
        "grunt": "^1.6.1",
        "grunt-cli": "^1.5.0",
        "grunt-shell": "^4.0.0",
        "grunt-wp-readme-to-markdown": "^2.1.0",
        "postcss-cli": "^11.0.1",
        "tailwindcss": "^4.1.13"
    }
}
